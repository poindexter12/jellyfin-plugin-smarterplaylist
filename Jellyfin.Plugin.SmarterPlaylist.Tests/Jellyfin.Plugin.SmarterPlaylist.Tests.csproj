<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>

		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- The plugin references these with ExcludeAssets=runtime because the server supplies
		     them at runtime. Tests need the real assemblies loadable, so reference them here
		     without that exclusion; otherwise anything touching a Jellyfin type fails to load. -->
		<PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
		<PackageReference Include="Jellyfin.Model" Version="10.11.11" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.2.0" />
		<PackageReference Include="xunit" Version="2.4.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="3.1.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jellyfin.Plugin.SmarterPlaylist\Jellyfin.Plugin.SmarterPlaylist.csproj" />
	</ItemGroup>

</Project>